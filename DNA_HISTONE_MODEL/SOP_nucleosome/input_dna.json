{
  "_comment_section_1": "=== FILE PATHS ===",

  "cg_pdb_dna"          : "dna_tis.pdb",
  "dna_bonds_file"      : "dna_bonds.dat",
  "dna_angles_file"     : "dna_angles.dat",
  "dna_stacking_file"   : "dna_stacking.dat",
  "dna_hbonds_file"     : "dna_hbonds.dat",
  "dna_charges_file"    : "dna_charges.dat",
  "dna_mass_file"       : "3_sigma_eps_mass_charge_dna.inp",

  "dcd_prefix"          : "/data/cg_dna_histone/sop_single_bead/run7_dna/dna_traj",
  "data_name"           : "/data/cg_dna_histone/sop_single_bead/run7_dna/dna_log.csv",
  "checkpoint_name"     : "/data/cg_dna_histone/sop_single_bead/run7_dna/dna_equil.chk",
  "energy_breakdown"    : "/data/cg_dna_histone/sop_single_bead/run7_dna/dna_energy_breakdown.out",
  "initial_pdb_name"    : "/data/cg_dna_histone/sop_single_bead/run7_dna/dna_initial.pdb",
  "final_state_name"    : "/data/cg_dna_histone/sop_single_bead/run7_dna/dna_final.pdb",
  "CHK_DIR"             : "/data/cg_dna_histone/sop_single_bead/run7_dna/checkpoints",
  "STATE_DIR"           : "/data/cg_dna_histone/sop_single_bead/run7_dna/states",

  "_comment_section_2": "=== DNA CHAINS ===",

  "dna_chains"          : ["I", "J"],

  "_comment_section_3": "=== FORCEFIELD PARAMETERS (TIS-DNA model, Chakraborty/Hori/Thirumalai eq 8/9/13) ===",

  "D0"              : 3.2,
  "eps0"            : 1.0,
  "U0_HB"           : -1.92,
  "kl_stack"        : 1.45,
  "kphi_stack"      : 3.00,
  "kd_HB"           : 4.00,
  "ktheta_HB"       : 1.50,
  "kpsi_HB"         : 0.15,

  "_comment_section_4": "=== ELECTROSTATICS ===",

  "electrostatics_mode" : "explicit_ions",
  "_electrostatics_mode_options" : "explicit_ions (PME + Mg/K/Cl, this section) | implicit_debye_huckel (paper's own monovalent-only eq 14-17, uses monovalent_salt_mM/phosphate_charge below instead)",
  "monovalent_salt_mM"  : 100.0,
  "phosphate_charge"    : -0.6,
  "_note_implicit_mode_only" : "monovalent_salt_mM and phosphate_charge are ONLY read when electrostatics_mode = implicit_debye_huckel.",
  "pme_cutoff"          : 30.0,

  "_comment_section_5": "=== EXPLICIT IONS (auto-computed from box volume, same convention as input.json) ===",

  "auto_ions"           : true,
  "KCl_mM"              : 100.0,
  "MgCl2_mM"            : 8.0,
  "neutralize"          : true,

  "nK"                  : 0,
  "nCl"                 : 0,
  "nMg"                 : 0,
  "_note_ion_counts"    : "nK/nCl/nMg above are only used directly if auto_ions=false. If auto_ions=true, they're computed from KCl_mM/MgCl2_mM x box volume, plus neutralization of the DNA's net (bare, -1e/phosphate) charge -- exactly like sop_hpc_openmm.py does for the protein.",

  "rK"                  : 1.590,
  "rCl"                 : 2.760,
  "rMg"                 : 1.353,
  "mK"                  : 39.0983,
  "mCl"                 : 35.453,
  "mMg"                 : 24.305,
  "epsK"                : 0.27946510,
  "epsCl"               : 0.01166150,
  "epsMg"               : 0.00941798,
  "qK"                  : 1.0,
  "qCl"                 : -1.0,
  "qMg"                 : 2.0,

  "ion_min_dist"        : 8.0,

  "_comment_section_6": "=== SIMULATION SETTINGS ===",

  "box_padding"         : 15.0,
  "box_scale_factor"    : 1.3,
  "nonlocal_cutoff"     : 30.0,

  "Temp"                : 298.0,
  "Boltz_Const"         : 0.001987,
  "friction_coeff"      : 1.0,
  "time_step"           : 0.002,
  "numsteps_equil"      : 20000000,
  "numsteps_prod"       : 10000000000,
  "data_interval"       : 5000,
  "snap_interval"       : 5000,
  "minimization"        : true,
  "minimization_maxiter": 5000,
  "minimization_tol"    : 100.0,
  "restart"             : false,

  "_comment_section_7": "=== PLATFORM ===",

  "platform_type"       : "CUDA",

  "_comment_section_8": "=== MISC ===",

  "ComMotionRemover"    : true,
  "CMMR_frequency"      : 100
}